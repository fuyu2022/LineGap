; Engine configuration file.
config_version=5

[application]
config/name="线隙 · LINE GAP"
config/version="v0.2.3-beta"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1080
window/size/viewport_height=720
window/size/window_width_override=1080
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=true
window/size/viewport_width.android=1440
window/size/viewport_height.android=810
window/stretch/aspect.android="expand"
window/handheld/orientation.android=0

[input_devices]
pointing/emulate_mouse_from_touch.android=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=120
